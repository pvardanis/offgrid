# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS directory metadata
.DS_Store

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage

# The worktrees agents are given to work in, and whatever settings one machine
# keeps to itself. The hooks and the settings that register them are versioned,
# because they enforce what CLAUDE.md states.
.claude/*
!.claude/hooks/
!.claude/settings.json
